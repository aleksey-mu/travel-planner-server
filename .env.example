# Required — generate secret; do not commit real .env
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}|%{[byte]$_}))
DATA_DIR=/data
JWT_SECRET=
HTTP_ADDR=:8080
# Web app origin(s) only (not the API URL). Canonical name: CORS_ORIGINS
CORS_ORIGINS=http://localhost:4200

# Optional
ALLOW_REGISTER=false
# Ignored for product — POST /auth/register always 403 (invite/CLI only)
JWT_TTL_SECONDS=3600
# Friendly host label for join / Settings /admin (optional; falls back to URL hostname)
SERVER_NAME=
# Public HTTPS origin for invite links (optional; must be https:// when set)
PUBLIC_BASE_URL=
# Soft cap on accounts (incl. disabled). 0 = unlimited. Default 100 (friends-scale).
MAX_USERS=100
INVITE_TTL_DAYS=7
PASSWORD_RESET_TTL_SECONDS=3600
# Auth brute-force limits (login / recover / invite accept / password-reset). 0 max = disabled.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Set true only behind a reverse proxy that sets X-Real-IP / X-Forwarded-For (Coolify, Caddy, nginx).
TRUST_PROXY=false
# Storage (mebibytes = MiB). Defaults: 10 GiB vault / 50 MiB per file.
# VAULT_QUOTA_MB=0 means unlimited (disk free space still applies).
# Effective limit = min(configured, usage + free disk on DATA_DIR) when configured is finite.
VAULT_QUOTA_MB=10240
MAX_UPLOAD_MB=50
LOG_FORMAT=json
LOG_LEVEL=info
# Prefer create-user CLI; seed only creates first admin when DB is empty. Remove password after first boot.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=Admin
HTTP_PUBLISH_PORT=8080
