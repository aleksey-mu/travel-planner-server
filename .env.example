# Required — generate secret; do not commit real .env
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}|%{[byte]$_}))
DATA_DIR=/data
JWT_SECRET=
HTTP_ADDR=:8080
# Web app origin(s) only (not the API URL). Canonical name: CORS_ORIGINS
CORS_ORIGINS=http://localhost:4200

# Optional
ALLOW_REGISTER=false
# Keep false — Phase 1 is single-owner vault (CLI/seed only; no self-serve register)
JWT_TTL_SECONDS=3600
# Storage (mebibytes = MiB). Defaults: 10 GiB vault / 50 MiB per file.
# Effective limit in the app = min(quota, free disk on DATA_DIR).
VAULT_QUOTA_MB=10240
MAX_UPLOAD_MB=50
LOG_FORMAT=json
LOG_LEVEL=info
# Prefer create-user CLI; if using seed, remove password from .env after first boot
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=Admin
HTTP_PUBLISH_PORT=8080
