# Plain VPS / local run. On Coolify only the optional values below are needed;
# domain (PUBLIC_BASE_URL) and JWT_SECRET are generated automatically.

# Required outside Coolify: openssl rand -base64 48
JWT_SECRET=
# Required outside Coolify: public https:// origin used in invite / reset links
PUBLIC_BASE_URL=

# First admin, created only when the DB is empty. Remove the password after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Web app origin(s), comma-separated (native apps ignore CORS)
CORS_ORIGINS=
# Label shown in the app; defaults to the PUBLIC_BASE_URL hostname
SERVER_NAME=

# Limits (defaults shown). MAX_USERS=0 and VAULT_QUOTA_MB=0 mean unlimited.
MAX_USERS=100
VAULT_QUOTA_MB=10240
MAX_UPLOAD_MB=50

# Local `go run` only: DATA_DIR defaults to ./data, HTTP_ADDR to :8080, TRUST_PROXY to false.
